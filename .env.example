# api-gateway configuration. Copy to .env for local runs; .env is gitignored.
#
# Every value below is the default the binary already uses, except JWT_SECRET,
# which has no default on purpose — see the note at the bottom.

SERVICE_NAME=api-gateway
SERVICE_VERSION=dev
ENVIRONMENT=local
HTTP_PORT=8090

LOG_LEVEL=info
LOG_FORMAT=json

# ---------------------------------------------------------------------------- #
# Upstreams
#
# These are the *internal* addresses, resolved on the compose network. The
# prefix each one is reached under is fixed in code (internal/gateway/routes.go),
# not configured here: a prefix is part of the platform's public contract and the
# frontend has it compiled in, so it must not be something an environment can
# quietly change.
#
#   /auth          -> auth-profile-service
#   /catalog       -> catalog-service
#   /orders        -> order-service
#   /wallet        -> wallet-service
#   /payment       -> payment-service
#   /media         -> media-service
#   /notifications -> notification-service

AUTH_SERVICE_URL=http://auth-profile-service:8085
WALLET_SERVICE_URL=http://wallet-service:8080
PAYMENT_SERVICE_URL=http://payment-service:8081
CATALOG_SERVICE_URL=http://catalog-service:8082
ORDER_SERVICE_URL=http://order-service:8083
MEDIA_SERVICE_URL=http://media-service:8084
NOTIFICATION_SERVICE_URL=http://notification-service:8086

# ---------------------------------------------------------------------------- #
# Edge policy

# Comma-separated allow-list. "*" is rejected outside local/development: the
# platform sends credentials, and `Allow-Origin: *` with credentials is both
# refused by browsers and wrong.
CORS_ORIGINS=http://localhost:3000

# Per-client-address budget. 600/min is ten requests a second, which is well
# above a browsing session and well below a scraper.
RATE_LIMIT_PER_MINUTE=600

# How long a single upstream request may take. Generous because media streams
# large files through here.
UPSTREAM_TIMEOUT=30s

# ---------------------------------------------------------------------------- #
# Token verification
#
# The gateway rejects a *malformed* token so a service never pays for one. It
# does not decide who may do what — each service owns the role rules for its own
# endpoints, and a second copy of those rules here would be a second list to keep
# in step. See the note on gateway.VerifyToken.
#
# JWT_SECRET must be the same value auth-profile-service signs with, at least 32
# characters, and must not be a placeholder in production. There is no default:
# a gateway that silently verifies against a well-known secret verifies nothing.

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=arcadia-auth
JWT_AUDIENCE=arcadia

# For a future move to RS256, set JWT_ALGORITHM=RS256 and put auth's public key
# here instead of the shared secret.
JWT_PUBLIC_KEY=
